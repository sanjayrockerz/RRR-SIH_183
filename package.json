{
  "name": "rrr-realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Reactive Tracing, Risk Registry and Prevention for Crypto Fraud using VASP",
  "scripts": {
    "start": "concurrently -k -n \"API,WEB\" -c \"blue,green\" \"npm run start:api\" \"npm run start:web\"",
    "dev": "concurrently -k -n \"API,WEB\" -c \"blue,green\" \"npm run start:api\" \"npm run start:web\"",
    "start:api": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir apps/api --reload",
    "start:web": "npm run dev --prefix apps/investigator-web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
