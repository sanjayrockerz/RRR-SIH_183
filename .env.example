ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_WEBHOOK_ID=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_NETWORK=eth-mainnet
TRONGRID_API_KEY=
TRONGRID_BASE_URL=https://api.trongrid.io
BRIDGE_REGISTRY_FILE=data/bridges/bridge_registry.json

# ── Backend origin (used for CORS) ──────────────────────────────────────────
# Set to the Railway (or other backend host) public URL in production.
API_ORIGIN=http://localhost:8000

# ── Extra CORS origins (space-separated) ────────────────────────────────────
# Add your Vercel frontend URL(s) here so the browser can call the API.
# Example: CORS_EXTRA_ORIGINS=https://my-app.vercel.app https://my-app-git-main.vercel.app
CORS_EXTRA_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# On Railway this is auto-injected by the PostgreSQL plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_fraud_intelligence
DATABASE_AUTO_MIGRATE=true

# ── Blockchain provider ───────────────────────────────────────────────────────
# LIVE = real Alchemy data   |   DEVELOPMENT_FIXTURE = mock data (no API calls)
BLOCKCHAIN_DATA_MODE=LIVE

# ── Neo4j (optional — app degrades gracefully if not set) ───────────────────
# Use a Neo4j Aura free-tier URI in production: neo4j+s://xxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=rrr_dev_password
NEO4J_DATABASE=neo4j

# ── Provider tuning ──────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

# ── Auth (disabled by default) ───────────────────────────────────────────────
AUTH_REQUIRED=false
# PEM-encoded OIDC/JWT verification key. Never place a private key here.
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# ── Realtime / Redis (optional — needed only for Phase G/7 live webhooks) ───
REALTIME_REQUIRED_CONFIRMATIONS=3
REALTIME_MAX_PROCESSING_ATTEMPTS=3
REALTIME_RETRY_DELAY_SECONDS=30
REDIS_URL=

# ── Trace defaults ────────────────────────────────────────────────────────────
TRACE_DEFAULT_HOPS=2
TRACE_DEFAULT_MAX_NODES=100
