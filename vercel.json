{
  "buildCommand": "cd apps/investigator-web && npm install && npm run build",
  "outputDirectory": "apps/investigator-web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "installCommand": "cd apps/investigator-web && npm install"
}
